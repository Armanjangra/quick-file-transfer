{
  "name": "quick-transfer",
  "version": "1.0.0",
  "description": "Quick File Transfer Application",
  "author": "AJ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.quicktransfer.app",
    "productName": "Quick File Transfer",
    "icon": "icon.ico",
    "files": [
      "server.js",
      "main.js",
      "icon.ico",
      "public/**/*",
      "uploads/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}